# GEMINI_API_KEY: Optional for AI Studio runtime (not required for core survey & analytics).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for the Admin Survey Management section.
# Defaults to 12345 in development if unset.
ADMIN_PASSCODE="12345"

# DB_PATH: Optional custom SQLite database file path.
DB_PATH="./survey_data.db"
