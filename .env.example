# GEMINI_API_KEY: Optional for AI Studio runtime (not required for core survey & analytics).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for the Admin Survey Management section.
# Defaults to 12345 in development if unset.
ADMIN_PASSCODE="12345"

# DB_PATH: Optional custom SQLite database file path.
DB_PATH="./survey_data.db"

# AUTH_EMAIL (or AUTH_USERNAME) & AUTH_PASSWORD (or AUTH_PASSWORD_HASH): Optional environment-configured login.
# INITIAL_ADMIN_USERNAME & INITIAL_ADMIN_PASSWORD: Optional overrides for first-boot admin seeding.
AUTH_EMAIL=
AUTH_PASSWORD=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
AUTH_IDLE_TIMEOUT_MINUTES=30

